{
  "name": "@spritz-finance/opencode",
  "version": "0.1.3",
  "description": "OpenCode plugin for Spritz Finance — off-ramp crypto to bank accounts with AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spritz-opencode": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/cli.ts --outfile ./dist/cli.js --target node && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "spritz",
    "payments",
    "off-ramp",
    "crypto",
    "fiat",
    "bank-transfer",
    "ai",
    "coding-agent"
  ],
  "author": "Spritz Finance <support@spritz.finance> (https://spritz.finance)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spritz-finance/spritz-opencode.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message"
    ]
  },
  "files": [
    "dist",
    "instructions"
  ],
  "publishConfig": {
    "access": "public"
  }
}
