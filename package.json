{
  "name": "@spritz-finance/opencode",
  "version": "0.1.4",
  "description": "Human-approved Spritz End User account tools for OpenCode off-ramp and fiat-rail workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spritz-opencode": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/cli.ts --outfile ./dist/cli.js --target node && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "spritz",
    "payments",
    "off-ramp",
    "crypto",
    "fiat",
    "bank-transfer",
    "ai",
    "coding-agent"
  ],
  "author": "Spritz Finance <support@spritz.finance> (https://spritz.finance)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spritz-finance/spritz-opencode.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message"
    ]
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
